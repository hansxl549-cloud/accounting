generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  title       String
  amount      Int      // Store cents to avoid floating point rounding.
  type        String   // INCOME or EXPENSE
  category    String
  date        DateTime
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type, date])
}
